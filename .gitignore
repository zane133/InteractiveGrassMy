# Unreal Engine generated folders
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/

# Plugin generated folders
/Plugins/*/Binaries/
/Plugins/*/Intermediate/

# UnrealSharp: C# glue project build output and UHT-generated bindings (under obj/, e.g. obj/UHT/)
**/*.Glue/bin/
**/*.Glue/obj/

# Plugin folder cloned as its own git repo (avoid tracking nested .git metadata)
Plugins/**/.git/

# Visual Studio and IDE files
/.vs/
*.VC.db
*.VC.opendb
*.suo
*.user
*.userprefs
*.sln.docstates

# Generated project files
*.opensdf
*.opendb
*.sdf
*.tmp

# Python cache files
__pycache__/
*.pyc
*.pyo

# Per-machine Python packages installed by Content/Python/PackageInstall.py
/Content/Python/PySide6/
/Content/Python/shiboken6/
/Content/Python/bin/
/Content/Python/pyside6-*.dist-info/
/Content/Python/pyside6_addons-*.dist-info/
/Content/Python/pyside6_essentials-*.dist-info/
/Content/Python/shiboken6-*.dist-info/
